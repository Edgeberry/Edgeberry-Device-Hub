# Edgeberry Device Hub - Core Service Environment Variables
#
# install.sh already seeds ADMIN_PASSWORD and JWT_SECRET into
# /etc/Edgeberry/devicehub/core.env on first install (write-once - a
# redeploy never overwrites them). This file is only for the handful of
# settings you might want to override afterwards. Copy just the lines you
# need into /etc/Edgeberry/devicehub/core.env and restart the service:
#
#   sudo nano /etc/Edgeberry/devicehub/core.env
#   sudo systemctl restart devicehub.service
#
# Do NOT set CERTS_DIR, ROOT_DIR, PROV_DIR, CA_KEY, CA_CRT, or
# PERSISTENT_CERTS_DIR here - they're derived from the installed directory
# layout, and overriding them points core-service at paths that don't
# actually hold the certificates deploy-artifacts.sh wrote, breaking
# certificate loading.

# Environment mode (production or development)
NODE_ENV=production

# Server port (3000 by default, for use behind a reverse proxy)
PORT=3000

# JWT session timeout, in seconds (default 86400 = 24h)
JWT_TTL_SECONDS=86400

# Device online threshold, in seconds - a device is shown offline once this
# long has passed since its last message
ONLINE_THRESHOLD_SECONDS=90

# MQTT connection used by core-service for telemetry capture
MQTT_URL=mqtt://127.0.0.1:1883
